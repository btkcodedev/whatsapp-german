# ═══════════════════════════════════════════════════════════════════════════
# 🇩🇪 WhatsApp German Learning Channel - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 Gemini AI Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 🗄️ MongoDB (free Atlas M0 cluster: https://www.mongodb.com/cloud/atlas/register)
# ─────────────────────────────────────────────────────────────────────────────

# Stores the WhatsApp session (Baileys creds) and channel progress.
# Same URI used locally (for `npm run link`) and in GitHub Actions secrets.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/whatsapp-german

# ─────────────────────────────────────────────────────────────────────────────
# 📱 WhatsApp Channel
# ─────────────────────────────────────────────────────────────────────────────

# The invite code from your channel's share link:
# https://whatsapp.com/channel/<THIS-PART>
CHANNEL_ID=your_channel_invite_code_here
CHANNEL_LEVEL=A1

# ─────────────────────────────────────────────────────────────────────────────
# Setup:
#   1. Fill in the values above and save as .env
#   2. npm install
#   3. npm run link        (scan the QR once — saves session to MongoDB)
#   4. Add GEMINI_API_KEY, MONGODB_URI, CHANNEL_ID as GitHub Actions secrets
#   5. Push — .github/workflows/daily-word.yml runs it daily, for free
# ─────────────────────────────────────────────────────────────────────────────
