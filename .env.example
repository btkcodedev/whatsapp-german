PORT=3000

# ─────────────────────────────────────────────────────────────
# Gemini API Key (free — get at aistudio.google.com)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────
# WhatsApp Channel ID
# From: https://whatsapp.com/channel/XXXXXXXXXX  ← copy XXXXXXXXXX
# ─────────────────────────────────────────────────────────────
CHANNEL_ID=your_channel_id_here

# ─────────────────────────────────────────────────────────────
# CEFR Level for the channel (A1 / A2 / B1 / B2 / C1 / C2)
# Individual DM users pick their own level via the bot.
# This controls what level gets posted to the PUBLIC channel.
# ─────────────────────────────────────────────────────────────
CHANNEL_LEVEL=A1
