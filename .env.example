PORT=3000

# ─────────────────────────────────────────────────────────────
# Gemini API Key (free tier — get one at aistudio.google.com)
# Used to generate the Word of the Day dynamically
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────
# WhatsApp Channel ID
# How to find: Channels → your channel → Invite via link
# Link: https://whatsapp.com/channel/XXXXXXXXXX  ← copy XXXXXXXXXX
# ─────────────────────────────────────────────────────────────
CHANNEL_ID=your_channel_id_here
